# Copy to backend/.env and fill in.
# production refuses to start on dev defaults.
ENV=development

DATABASE_URL=postgresql+psycopg://draftnotes:draftnotes@localhost:5432/draftnotes
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300

REDIS_URL=redis://localhost:6379/0
SYNC_QUEUE_NAME=sync:default
SYNC_COOLDOWN_SECONDS=60
SYNC_MAX_QUEUE_DEPTH=500
# keep the worker at one replica
SYNC_WORKER_CONCURRENCY=5
SYNC_POLL_DELAY_SECONDS=10

# comma-separated, no localhost in production
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
# LOG_JSON=false

# refused in production if unchanged
SESSION_SECRET=dev-only-insecure-session-secret
SESSION_MAX_AGE_SECONDS=2592000

# one provider required in production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# where login redirects back to
FRONTEND_URL=http://localhost:5173

# public origin for oauth callbacks
# OAUTH_REDIRECT_BASE_URL=https://draftnotes.gg

# signs in as any email
# DEV_LOGIN_ENABLED=true

# no-sign-in demo account, safe in production. seed it with: python -m app.demo.seed
# DEMO_MODE_ENABLED=true
# DEMO_LOGIN_COOLDOWN_SECONDS=30
# DEMO_USER_TTL_DAYS=7

# expires every 24h
RIOT_API_KEY=

# serve saved json instead of Riot
USE_FIXTURES=false
FIXTURES_DIR=./fixtures

# writes live responses to disk
# CAPTURE_FIXTURES=true
